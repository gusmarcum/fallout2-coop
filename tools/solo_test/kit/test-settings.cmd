@rem Settings for the solo test. Every launcher in this folder reads them.
@rem
@rem HOST_NAME    your character's name in the save (you join as this one)
@rem FRIEND_NAME  the second character's name in the save (the stand-in holds this seat)
@rem SAVE_SLOT    the save the test server loads, and its folder under test-save
@rem TEST_NET     game port of the test server. Not 9300 or 9700: those are real worlds.
@rem TEST_ADMIN   operator console port of the test server
set "HOST_NAME=Host"
set "FRIEND_NAME=Friend"
set "SAVE_SLOT=9"
set "SAVE_DIR=SLOT09"
set "TEST_NET=9800"
set "TEST_ADMIN=9801"
